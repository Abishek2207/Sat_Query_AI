# API Configuration
PORT=8000
FRONTEND_ORIGIN=https://satquery-ai.vercel.app

# HuggingFace Strategy
# In production, models will dynamically download from HF if not cached.
# Set these to "0" in production to allow the download, or "1" to strictly enforce local-only.
HF_HUB_OFFLINE=0
TRANSFORMERS_OFFLINE=0

# If adapter.pt is excluded from git, provide the URL to download it at startup
# RSICD_ADAPTER_URL=https://your-storage-bucket.com/adapter.pt
